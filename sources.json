{
  "schema_version": 1,
  "publish_repository": "easylifegoal/proxy-rules",
  "upstreams": {
    "metacubex": {"repository": "MetaCubeX/meta-rules-dat", "branch": "meta"},
    "fakeip": {"repository": "wwqgtxx/clash-rules", "branch": "release"}
  },
  "rules": [
    {"name": "fakeipfilter_domain", "behavior": "domain", "upstream": "fakeip", "path": "fakeip-filter.mrs", "minimum_entries": 60, "surge": false},
    {"name": "private_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/private.mrs", "minimum_entries": 50},
    {"name": "ai", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/category-ai-!cn.mrs", "minimum_entries": 90},
    {"name": "github_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/github.mrs", "minimum_entries": 30},
    {"name": "telegram_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/telegram.mrs", "minimum_entries": 10},
    {"name": "global_media_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/category-entertainment.mrs", "minimum_entries": 1000},
    {"name": "netflix_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/netflix.mrs", "minimum_entries": 12},
    {"name": "paypal_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/paypal.mrs", "minimum_entries": 100},
    {"name": "usbank_domain", "output": "usbank", "behavior": "domain", "local": "custom/usbank.txt", "minimum_entries": 6, "classical_yaml": true, "aliases": ["BankOfAmerica"]},
    {"name": "onedrive_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/onedrive.mrs", "minimum_entries": 8},
    {"name": "microsoft_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/microsoft.mrs", "minimum_entries": 300},
    {"name": "apple_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/apple.mrs", "minimum_entries": 700},
    {"name": "geolocation-!cn", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/geolocation-!cn.mrs", "minimum_entries": 10000},
    {"name": "cn_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/cn.mrs", "minimum_entries": 50000},
    {"name": "private_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo/geoip/private.mrs", "minimum_entries": 8},
    {"name": "cn_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo/geoip/cn.mrs", "minimum_entries": 4000},
    {"name": "telegram_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo/geoip/telegram.mrs", "minimum_entries": 6},
    {"name": "netflix_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo/geoip/netflix.mrs", "minimum_entries": 50},
    {"name": "apple_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo-lite/geoip/apple.mrs", "minimum_entries": 5}
  ]
}
