{
  "schema_version": 1,
  "publish_repository": "easylifegoal/proxy-rules",
  "upstreams": {
    "metacubex": {"repository": "MetaCubeX/meta-rules-dat", "branch": "meta"},
    "fakeip": {"repository": "wwqgtxx/clash-rules", "branch": "release"},
    "apns": {"repository": "QuixoticHeart/rule-set", "branch": "ruleset"}
  },
  "rules": [
    {"name": "fakeipfilter_domain", "behavior": "domain", "upstream": "fakeip", "path": "fakeip-filter.mrs", "minimum_entries": 60, "surge": false},
    {"name": "private_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/private.mrs", "minimum_entries": 50},
    {"name": "ai", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/category-ai-!cn.mrs", "minimum_entries": 90},
    {"name": "claude_domain", "behavior": "classical", "input_behavior": "domain", "input_format": "mrs", "cache_tag": "classical-v1", "upstream": "metacubex", "path": "geo/geosite/anthropic.mrs", "minimum_entries": 7},
    {"name": "github_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/github.mrs", "minimum_entries": 30},
    {"name": "telegram_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/telegram.mrs", "minimum_entries": 10},
    {"name": "global_media_domain", "behavior": "domain", "minimum_entries": 350, "inputs": [
      {"id": "youtube", "upstream": "metacubex", "path": "geo/geosite/youtube.mrs", "minimum_entries": 100},
      {"id": "netflix", "upstream": "metacubex", "path": "geo/geosite/netflix.mrs", "minimum_entries": 12},
      {"id": "disneyplus", "upstream": "metacubex", "path": "geo/geosite/disney.mrs", "minimum_entries": 100,
       "select": ["+.bamgrid.com", "+.dilcdn.com", "+.disney-plus.net", "+.disneyaccount.com", "+.disneyplus.com", "+.disneyprivacycenter.com", "+.disneyredirects.com", "+.disneystreaming.com", "+.disneysubscription.com", "+.disneytermsofuse.com", "+.dssott.com", "+.streamingdisney.net", "disneyplus.com.ssl.sc.omtrdc.net"]},
      {"id": "hbo", "upstream": "metacubex", "path": "geo/geosite/hbo.mrs", "minimum_entries": 30},
      {"id": "primevideo", "upstream": "metacubex", "path": "geo/geosite/primevideo.mrs", "minimum_entries": 10},
      {"id": "apple-tvplus", "upstream": "metacubex", "path": "geo/geosite/apple-tvplus.mrs", "minimum_entries": 5},
      {"id": "spotify", "upstream": "metacubex", "path": "geo/geosite/spotify.mrs", "minimum_entries": 15},
      {"id": "twitch", "upstream": "metacubex", "path": "geo/geosite/twitch.mrs", "minimum_entries": 20},
      {"id": "hulu", "upstream": "metacubex", "path": "geo/geosite/hulu.mrs", "minimum_entries": 25},
      {"id": "abema", "upstream": "metacubex", "path": "geo/geosite/abema.mrs", "minimum_entries": 10},
      {"id": "dazn", "upstream": "metacubex", "path": "geo/geosite/dazn.mrs", "minimum_entries": 4},
      {"id": "discoveryplus", "upstream": "metacubex", "path": "geo/geosite/discoveryplus.mrs", "minimum_entries": 2},
      {"id": "vimeo", "upstream": "metacubex", "path": "geo/geosite/vimeo.mrs", "minimum_entries": 8},
      {"id": "dailymotion", "upstream": "metacubex", "path": "geo/geosite/dailymotion.mrs", "minimum_entries": 2},
      {"id": "plutotv", "upstream": "metacubex", "path": "geo/geosite/plutotv.mrs", "minimum_entries": 2},
      {"id": "deezer", "upstream": "metacubex", "path": "geo/geosite/deezer.mrs", "minimum_entries": 2},
      {"id": "tidal", "upstream": "metacubex", "path": "geo/geosite/tidal.mrs", "minimum_entries": 2},
      {"id": "soundcloud", "upstream": "metacubex", "path": "geo/geosite/soundcloud.mrs", "minimum_entries": 2},
      {"id": "apple-music", "upstream": "metacubex", "path": "geo/geosite/apple-music.mrs", "minimum_entries": 10},
      {"id": "apple-podcasts", "upstream": "metacubex", "path": "geo/geosite/apple-podcasts.mrs", "minimum_entries": 2}
    ]},
    {"name": "youtube_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/youtube.mrs", "minimum_entries": 100},
    {"name": "netflix_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/netflix.mrs", "minimum_entries": 12},
    {"name": "paypal_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/paypal.mrs", "minimum_entries": 100},
    {"name": "usbank_domain", "output": "usbank", "behavior": "domain", "local": "custom/usbank.txt", "minimum_entries": 6, "classical_yaml": true, "aliases": ["BankOfAmerica"]},
    {"name": "onedrive_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/onedrive.mrs", "minimum_entries": 8},
    {"name": "microsoft_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/microsoft.mrs", "minimum_entries": 300},
    {"name": "google_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/google.mrs", "minimum_entries": 500},
    {"name": "apns", "behavior": "classical", "input_format": "classical", "upstream": "apns", "path": "loon/apns.list", "minimum_entries": 10},
    {"name": "apple_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/apple.mrs", "minimum_entries": 700},
    {"name": "geolocation-!cn", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/geolocation-!cn.mrs", "minimum_entries": 10000},
    {"name": "cn_domain", "behavior": "domain", "upstream": "metacubex", "path": "geo/geosite/cn.mrs", "minimum_entries": 50000},
    {"name": "private_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo/geoip/private.mrs", "minimum_entries": 8},
    {"name": "cn_ip", "behavior": "ipcidr", "surge_no_resolve": false, "cache_tag": "resolve-v1", "upstream": "metacubex", "path": "geo/geoip/cn.mrs", "minimum_entries": 4000},
    {"name": "telegram_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo/geoip/telegram.mrs", "minimum_entries": 6},
    {"name": "netflix_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo/geoip/netflix.mrs", "minimum_entries": 50},
    {"name": "apple_ip", "behavior": "ipcidr", "upstream": "metacubex", "path": "geo-lite/geoip/apple.mrs", "minimum_entries": 5}
  ]
}
